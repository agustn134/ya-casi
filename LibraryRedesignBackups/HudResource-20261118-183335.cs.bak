using System.Collections;
using System.Collections.Generic;
using TMPro;
using UnityEngine;
using UnityEngine.InputSystem;
using UnityEngine.EventSystems;
using UnityEngine.SceneManagement;
using UnityEngine.UI;

/// <summary>Nivel 2: búsqueda de tres libros, ruido, bibliotecaria y salida contrarreloj.</summary>
public sealed class LibraryLevelManager : MonoBehaviour
{
    public const string SceneName = "Nivel02_MaratonEnLaBiblioteca";
    public PlayerMovement player;
    public LibraryLibrarian librarian;
    public LibraryShelf[] shelves;
    public Transform exit;
    public LibraryExitZone exitZone;
    public Sprite[] bookIcons;
    [SerializeField] AudioClip levelMusicOverride;
    [SerializeField] AudioClip timeoutMusicOverride;
    public float roundSeconds = 210f;
    public float wrongShelfPenalty = 6f;
    public float hintCost = 8f;
    public float searchSeconds = .85f;
    public string[] bookNames = { "Algoritmos", "Bases de datos", "Redes" };
    public PlayerMovement Player => player;
    public bool IsPlaying => !ended && !paused;
    public bool PlayerIsRunning => IsPlaying && !frozen && player != null && player.IsRunning && body != null && body.linearVelocity.sqrMagnitude > .1f;
    public int CollectedCount { get; private set; }
    public float RemainingTime => remaining;
    public bool IsCompleted { get; private set; }
    public bool IsFailed => ended && !IsCompleted;
    public int Reprimands { get; private set; }
    public bool AtExit => exitZone != null ? exitZone.Contains(player) : exit != null && Mathf.Abs(player.transform.position.x - exit.position.x) <= 1.8f && Mathf.Abs(player.transform.position.y - exit.position.y) <= 1.3f;
    LibraryFloorHazard[] floorHazards;
    readonly bool[] revealedHints = new bool[3];
    bool searching, slowed;
    float searchStarted;
    readonly bool[] collected = new bool[3];
    readonly List<Image> inventory = new List<Image>();
    TMP_Text clock, objective, prompt, feedback, noise, catalog, routeHint;
    Image timeFill, progressFill;
    readonly TMP_Text[] bookLabels = new TMP_Text[3];
    readonly string[] shelfHints = new string[3];
    GameObject hud, overlay;
    Rigidbody2D body;
    AudioSource music, effects;
    AudioClip collectSound, errorSound, shushSound, stepSound;
    LibraryShelf nearest;
    LineRenderer ring;
    float remaining, elapsed, feedbackUntil, nextInteraction, stepDistance;
    Vector2 previousPosition;
    int score;
    bool paused, ended, frozen, closingWarning, selectFirstDialogButton;
    float freezeUntil;
    public string MissionObjective => CollectedCount == 3 ? "SAL DEL EDIFICIO CON LAS REFERENCIAS" : "RECUPERA LAS REFERENCIAS · " + CollectedCount + "/3";
    bool UsingGamepad => Gamepad.current != null && (Keyboard.current == null || Gamepad.current.lastUpdateTime > Keyboard.current.lastUpdateTime);
    string ActionLabel => Application.isMobilePlatform ? "Revisar" : UsingGamepad ? "Botón sur" : "E";
    Color gold = new Color(1f, .84f, .42f);

    void Start()
    {
        Time.timeScale = 1;
        remaining = roundSeconds;
        body = player.GetComponent<Rigidbody2D>();
        previousPosition = player.transform.position;
        PlayerPrefs.SetInt(U2Presentation.SaveKey, 2);
        PlayerPrefs.Save();
        floorHazards = FindObjectsByType<LibraryFloorHazard>(FindObjectsSortMode.None);
        AssignBooks();
        BuildHud();
        BuildAudio();
        BuildRing();
        ShowTutorial();
    }
    void AssignBooks()
    {
        // Barajado sin reemplazo: tres libros distintos en tres estantes de todo el mapa.
        var available = new List<LibraryShelf>(shelves);
        foreach (var shelf in shelves) { shelf.bookIndex = -1; shelf.searched = false; }
        for (int book = 0; book < collected.Length && available.Count > 0; book++)
        {
            // Cada referencia pertenece a su sector; el estante cambia entre partidas.
            string prefix = ((char)('A' + book)).ToString();
            var candidates = available.FindAll(shelf => shelf.section.StartsWith(prefix));
            var target = candidates.Count > 0 ? candidates[Random.Range(0, candidates.Count)] : available[Random.Range(0, available.Count)];
            target.bookIndex = book;
            shelfHints[book] = target.section;
            available.Remove(target);
        }
    }
    void Update()
    {
        var keyboard = Keyboard.current;
        var gamepad = Gamepad.current;
        if ((keyboard != null && keyboard.escapeKey.wasPressedThisFrame) || (gamepad != null && gamepad.startButton.wasPressedThisFrame)) TogglePause();
        if (ended)
        {
            if (keyboard != null && keyboard.rKey.wasPressedThisFrame) Restart();
            return;
        }
        if (music != null) music.volume = U2Presentation.MusicVolume * .55f;
        if (!IsPlaying) return;
        float speedMultiplier = 1f;
        foreach (var hazard in floorHazards)
            if (hazard != null && hazard.isActiveAndEnabled && hazard.Contains(player.transform.position))
                speedMultiplier = Mathf.Min(speedMultiplier, hazard.speedMultiplier);
        slowed = speedMultiplier < 1f;
        player.EnvironmentSpeedMultiplier = speedMultiplier;
        if ((keyboard != null && keyboard.hKey.wasPressedThisFrame) || (gamepad != null && gamepad.buttonNorth.wasPressedThisFrame)) RevealHint();
        if (ended) return;
        remaining = Mathf.Max(0, remaining - Time.deltaTime);
        elapsed += Time.deltaTime;
        if (remaining <= 0) { Finish(false); return; }
        if (TryExit(false)) return;
        if (!closingWarning && remaining <= 30)
        {
            closingWarning = true;
            Notify(CollectedCount == 3 ? "Cierre en 30 s. Sigue la indicación de salida." : "Cierre en 30 s. Busca en tu sector o compra una pista si puedes.");
        }
        routeHint.text = RouteText();
        if (Time.time >= feedbackUntil) feedback.text = "";
        feedback.transform.parent.gameObject.SetActive(!string.IsNullOrEmpty(feedback.text));
        nearest = null;
        float best = 1.35f;
        foreach (var shelf in shelves)
        {
            float distance = Vector2.Distance(player.transform.position, shelf.Position);
            if (distance < best) { best = distance; nearest = shelf; }
        }
        foreach (var shelf in shelves) shelf.Highlight(!frozen && shelf == nearest, shelf.bookIndex >= 0 && !collected[shelf.bookIndex] && revealedHints[shelf.bookIndex]);
        bool nearExit = AtExit;
        prompt.text = searching ? "BUSCANDO REFERENCIA · " + Mathf.RoundToInt(Mathf.Clamp01((Time.time - searchStarted) / searchSeconds) * 100) + "%" : frozen ? "¡Shhh! Espera un momento…" : nearExit ? (CollectedCount == 3 ? "SALIDA ABIERTA · cruza la zona verde" : "Salida cerrada · faltan " + (3 - CollectedCount) + " libros") : nearest != null ? (nearest.searched ? "YA REVISADO · " + nearest.section + " · puedes seguir al siguiente estante" : ActionLabel + " · Revisar " + nearest.section) : (slowed ? "PISO MOJADO · movimiento lento; rodea el derrame" : "Busca en el sector indicado · H / botón norte: pista (−" + hintCost + " s)");
        if ((keyboard != null && keyboard.eKey.wasPressedThisFrame) || (gamepad != null && gamepad.buttonSouth.wasPressedThisFrame)) Interact();
        int displaySeconds = Mathf.CeilToInt(remaining);
        clock.text = "CIERRE  " + (displaySeconds / 60).ToString("00") + ":" + (displaySeconds % 60).ToString("00");
        clock.color = remaining < 30 ? new Color(1, .4f, .35f) : gold;
        timeFill.fillAmount = Mathf.Clamp01(remaining / Mathf.Max(1, roundSeconds));
        timeFill.color = clock.color;
        noise.text = frozen ? "¡SHHH! · espera " + Mathf.CeilToInt(Mathf.Max(0, freezeUntil - Time.time)) + " s" : librarian.Investigating ? "TE ESCUCHARON · camina para recuperar el silencio" : PlayerIsRunning ? "RUIDO ALTO · " + (Application.isMobilePlatform ? "suelta Correr" : UsingGamepad ? "suelta el gatillo" : "suelta Shift") : "EN SILENCIO · camina cerca de la bibliotecaria";
        noise.color = PlayerIsRunning || librarian.Investigating ? new Color(1, .55f, .4f) : new Color(.65f, .88f, .8f);
        ring.enabled = PlayerIsRunning;
        ring.transform.position = player.transform.position;
        var position = (Vector2)player.transform.position;
        stepDistance += Vector2.Distance(position, previousPosition);
        previousPosition = position;
        if (stepDistance > .9f && !frozen)
        {
            stepDistance = 0;
            effects.PlayOneShot(stepSound, U2Presentation.EffectsVolume * .18f);
        }
    }
    public void Interact()
    {
        if (!IsPlaying || frozen || searching || Time.time < nextInteraction) return;
        nextInteraction = Time.time + .35f;
        if (AtExit) { TryExit(true); return; }
        // Recalcula en el momento de pulsar E; no depende del orden de Update del input.
        nearest = null;
        float distance = 1.35f;
        foreach (var shelf in shelves)
        {
            float candidate = Vector2.Distance(player.transform.position, shelf.Position);
            if (candidate < distance) { distance = candidate; nearest = shelf; }
        }
        if (nearest != null) { StartCoroutine(SearchShelf(nearest)); return; }
    }
    IEnumerator SearchShelf(LibraryShelf shelf)
    {
        if (shelf.searched) { Notify("Estante revisado. Sigue buscando en tu sector; repetir no cuesta tiempo."); yield break; }
        searching = true; searchStarted = Time.time;
        player.enabled = false; body.linearVelocity = Vector2.zero;
        yield return new WaitForSeconds(searchSeconds);
        searching = false;
        if (ended) yield break;
        if (!frozen) player.enabled = true;
        Review(shelf);
    }
    public void RevealHint()
    {
        if (!IsPlaying || frozen || searching) return;
        for (int i = 0; i < collected.Length; i++)
        {
            if (collected[i] || revealedHints[i]) continue;
            if (remaining <= hintCost) { Notify("No queda tiempo suficiente para comprar una pista."); return; }
            remaining -= hintCost; revealedHints[i] = true;
            catalog.text = CatalogText(); routeHint.text = RouteText();
            Notify("Pista: " + bookNames[i] + " está en " + shelfHints[i] + " · −" + hintCost + " s");
            return;
        }
        Notify(CollectedCount == 3 ? "Ya tienes las referencias. Regresa a la salida." : "Ya revelaste todas las pistas pendientes. Consulta el catálogo.");
    }
    public bool TryExit(bool showHint)
    {
        if (!IsPlaying || frozen || !AtExit) return false;
        if (CollectedCount == 3) { Finish(true); return true; }
        if (showHint) Notify("Necesitas los tres libros antes de salir. Te faltan " + (3 - CollectedCount) + ".");
        return false;
    }
    public void Review(LibraryShelf shelf)
    {
        if (!IsPlaying || frozen || shelf == null) return;
        if (shelf.searched) { Notify("Este estante ya está revisado. Prueba otro del mismo sector."); return; }
        shelf.searched = true;
        if (shelf.bookIndex >= 0 && !collected[shelf.bookIndex])
        {
            int index = shelf.bookIndex;
            collected[index] = true; CollectedCount++; score += 300;
            inventory[index].color = Color.white;
            bookLabels[index].text = "<color=#99E4CA>RECUPERADO</color>\n" + bookNames[index];
            progressFill.fillAmount = CollectedCount / 3f;
            Notify("Referencia recuperada: " + bookNames[index] + " · " + CollectedCount + "/3" + (CollectedCount == 3 ? " · Vuelve a la salida para llevárselas al equipo." : " · Consulta tu siguiente estante."));
            effects.PlayOneShot(collectSound, U2Presentation.EffectsVolume);
        }
        else
        {
            remaining = Mathf.Max(0, remaining - wrongShelfPenalty);
            Notify("No está el libro que necesitas · −" + wrongShelfPenalty + " segundos. Los estantes revisados quedan marcados.");
            effects.PlayOneShot(errorSound, U2Presentation.EffectsVolume * .6f);
            if (remaining <= 0) Finish(false);
        }
        objective.text = MissionObjective;
        routeHint.text = RouteText();
        catalog.text = CatalogText();
    }
    string CatalogText()
    {
        string text = "REFERENCIAS PARA LA ENTREGA\n";
        for (int i = 0; i < 3; i++) text += (collected[i] ? "[OK] " : "[ ] ") + bookNames[i] + (collected[i] ? "" : revealedHints[i] ? " · estante " + shelfHints[i] : " · sector " + (char)('A' + i)) + (i < 2 ? "\n" : "");
        return text;
    }
    public void Notify(string message) { feedback.text = message; feedback.transform.parent.gameObject.SetActive(true); feedbackUntil = Time.time + 4f; }
    public void Reprimand()
    {
        if (!IsPlaying || frozen) return;
        Reprimands++;
        var libraryCamera = FindFirstObjectByType<LibraryCamera>();
        if (libraryCamera != null) libraryCamera.Shake();
        StartCoroutine(Freeze());
    }
    IEnumerator Freeze()
    {
        freezeUntil = Time.time + 3f;
        frozen = true; player.enabled = false; body.linearVelocity = Vector2.zero;
        Notify("¡Shhh! Aquí se viene a leer. Detenido durante 3 segundos.");
        effects.PlayOneShot(shushSound, U2Presentation.EffectsVolume);
        yield return new WaitForSeconds(3);
        frozen = false;
        if (!ended) player.enabled = true;
    }
    public void TogglePause()
    {
        if (ended) return;
        if (paused) { Resume(); return; }
        paused = true; Time.timeScale = 0;
        var card = Overlay("PAUSA", "Tu equipo espera las referencias para terminar la entrega.\n" + MissionObjective);
        var description = card.transform.Find("Descripción").GetComponent<TMP_Text>();
        description.rectTransform.anchoredPosition = new Vector2(0, 200);
        description.rectTransform.sizeDelta = new Vector2(1100, 120);
        DialogButton(card.transform, "Continuar", new Vector2(0, -40), Resume);
        DialogButton(card.transform, "Reiniciar", new Vector2(0, -140), Restart);
        DialogButton(card.transform, "Opciones", new Vector2(0, -240), () => U2Presentation.Options(overlay.transform, null));
        DialogButton(card.transform, "Menú principal", new Vector2(0, -340), U2Presentation.ReturnToMenu);
    }
    void ShowTutorial()
    {
        paused = true; Time.timeScale = 0;
        var card = Overlay("MARATÓN EN LA BIBLIOTECA",
            "Tu equipo está por terminar la entrega, pero faltan tres referencias.\n" +
            "La biblioteca cierra pronto y tú eres quien puede recuperarlas.\n\n" +
            "01  EXPLORA · Cada referencia está en su sector A, B o C.\n" +
            "02  RECUPERA · Reúne Algoritmos, Bases de datos y Redes.\n" +
            "03  REGRESA · Cruza la salida con las tres referencias.\n\n" +
            "Camina cerca de la bibliotecaria. Si te escucha,\n" +
            "dos segundos sin hacer ruido permiten despistarla.\n" +
            "Rodea los carros y los derrames: el piso mojado te frena.");
        var description = card.transform.Find("Descripción").GetComponent<TMP_Text>();
        description.fontSize = 29;
        DialogButton(card.transform, "Ver controles y comenzar", new Vector2(0, -320), ShowControls);
    }
    void ShowControls()
    {
        var card = Overlay("ANTES DE ENTRAR",
            "TECLADO · WASD / flechas para moverte · Shift para correr\n" +
            "E para buscar · Esc para pausar\n\n" +
            "MANDO · Stick para moverte · gatillo para correr\n" +
            "Botón sur para buscar · Start para pausar\n\n" +
            "En pantalla táctil utiliza las direcciones y los botones.\n" +
            "Buscar sin encontrar un libro nuevo cuesta " + wrongShelfPenalty + " s.\n" +
            "Pista exacta: −" + hintCost + " s · Repetir un estante revisado: sin coste.\n" +
            "Un regaño te detiene 3 s; el reloj sigue avanzando.");
        DialogButton(card.transform, "Comenzar misión", new Vector2(0, -320), Resume);
    }
    // Orientación directa al objetivo; no representa un camino libre de obstáculos.
    public string RouteText()
    {
        Vector2 destination;
        string caption;
        if (CollectedCount == 3)
        {
            if (exit == null) return "REFERENCIAS COMPLETAS · busca la puerta de salida";
            destination = exit.position;
            caption = "SALIDA";
        }
        else
        {
            LibraryShelf target = null;
            float best = float.PositiveInfinity;
            foreach (var shelf in shelves)
            {
                if (shelf == null || shelf.searched || shelf.bookIndex < 0 || shelf.bookIndex >= collected.Length || collected[shelf.bookIndex]) continue;
                float distance = Vector2.SqrMagnitude(shelf.Position - (Vector2)player.transform.position) + (revealedHints[shelf.bookIndex] ? 0 : 10000);
                if (distance < best) { best = distance; target = shelf; }
            }
            if (target == null) return "Consulta el catálogo de referencias";
            if (!revealedHints[target.bookIndex])
            {
                string sector = ((char)('A' + target.bookIndex)).ToString();
                return bookNames[target.bookIndex] + " · EXPLORA EL SECTOR " + sector + " · pista exacta: −" + hintCost + " s";
            }
            destination = target.Position;
            caption = bookNames[target.bookIndex] + " · ESTANTE " + target.section;
        }
        Vector2 delta = destination - (Vector2)player.transform.position;
        if (delta.magnitude <= 1.35f) return caption + " · " + (CollectedCount == 3 ? "cruza la puerta" : ActionLabel + " para buscar");
        string vertical = delta.y > .5f ? "ARRIBA" : delta.y < -.5f ? "ABAJO" : "";
        string horizontal = delta.x > .5f ? "DERECHA" : delta.x < -.5f ? "IZQUIERDA" : "";
        string direction = vertical + (vertical != "" && horizontal != "" ? " / " : "") + horizontal;
        return caption + " · " + direction + " · " + Mathf.CeilToInt(delta.magnitude) + " m en línea recta";
    }
    GameObject Overlay(string title, string description)
    {
        if (overlay != null) Destroy(overlay);
        selectFirstDialogButton = true;
        overlay = U2Presentation.NewCanvas("Biblioteca · diálogo", 120);
        overlay.GetComponent<CanvasScaler>().screenMatchMode = CanvasScaler.ScreenMatchMode.Expand;
        var card = U2Presentation.Card(overlay.transform, "Panel");
        card.GetComponent<Image>().color = new Color32(17, 35, 44, 255);
        var accent = U2Presentation.Image(card.transform, "Acento biblioteca", gold);
        accent.rectTransform.anchoredPosition = new Vector2(0, 420);
        accent.rectTransform.sizeDelta = new Vector2(1280, 6);
        accent.raycastTarget = false;
        U2Presentation.Text(card.transform, "Título", title, new Vector2(0, 315), new Vector2(1180, 100), 46, gold);
        U2Presentation.Text(card.transform, "Descripción", description, new Vector2(0, 70), new Vector2(1140, 390), 31, Color.white);
        return card;
    }
    Button DialogButton(Transform parent, string caption, Vector2 position, UnityEngine.Events.UnityAction action)
    {
        var button = U2Presentation.Button(parent, caption, position, action);
        if (selectFirstDialogButton && EventSystem.current != null)
        {
            EventSystem.current.SetSelectedGameObject(button.gameObject);
            selectFirstDialogButton = false;
        }
        return button;
    }
    public void Resume()
    {
        if (EventSystem.current != null) EventSystem.current.SetSelectedGameObject(null);
        if (overlay != null) Destroy(overlay);
        paused = false; Time.timeScale = 1;
        previousPosition = player.transform.position;
    }
    public void Restart() { Time.timeScale = 1; SceneManager.LoadScene(SceneName); }
    void Finish(bool success)
    {
        if (ended) return;
        ended = true; IsCompleted = success; paused = false; Time.timeScale = 0;
        player.enabled = false; body.linearVelocity = Vector2.zero; ring.enabled = false;
        if (music != null) music.Stop();
        if (success)
        {
            score += Mathf.CeilToInt(remaining) * 10;
            PlayerPrefs.SetInt("YaCasi.Library.Completed", 1);
            PlayerPrefs.SetInt("YaCasi.Library.Best", Mathf.Max(score, PlayerPrefs.GetInt("YaCasi.Library.Best", 0)));
            PlayerPrefs.Save();
        }
        else PlayGameOverMusic();
        var card = Overlay(success ? "¡LECTURAS COMPLETAS!" : "LA BIBLIOTECA CERRÓ", (success ? "Tu equipo ya tiene las tres referencias.\nEl trabajo puede continuar: llegaste antes del cierre." : "La biblioteca cerró antes de reunir las referencias.\nEn el próximo intento, sigue el catálogo y camina cerca de la bibliotecaria.") + "\n\nLibros: " + CollectedCount + "/3 · Regaños: " + Reprimands + "\nTiempo de juego: " + Mathf.CeilToInt(elapsed) + " s\nPuntaje: " + score + " · Récord: " + PlayerPrefs.GetInt("YaCasi.Library.Best", 0));
        DialogButton(card.transform, "Volver a jugar", new Vector2(0, -180), Restart);
        DialogButton(card.transform, "Menú principal", new Vector2(0, -280), U2Presentation.ReturnToMenu);
    }
    void PlayGameOverMusic()
    {
        var config = Resources.Load<U2GameConfig>("U2GameConfig");
        AudioClip timeoutClip = timeoutMusicOverride != null ? timeoutMusicOverride : config?.gameOverSound;
        if (timeoutClip == null)
        {
            Debug.LogError("Biblioteca: falta la música Game Over compartida con el nivel 1.", this);
            return;
        }
        music.playOnAwake = false;
        music.loop = false;
        music.spatialBlend = 0;
        music.mute = false;
        music.ignoreListenerPause = true;
        music.volume = U2Presentation.MusicVolume;
        music.clip = timeoutClip;
        music.Play();
        Debug.Log("LIBRARY_GAME_OVER_MUSIC: " + music.clip.name, this);
    }
    void BuildHud()
    {
        hud = U2Presentation.NewCanvas("HUD Biblioteca", 20);
        hud.GetComponent<CanvasScaler>().screenMatchMode = CanvasScaler.ScreenMatchMode.Expand;
        // HUD compacto: misión a la izquierda, reloj a la derecha y catálogo al pie.
        PanelText("Capítulo", "NIVEL 02 / MARATÓN EN LA BIBLIOTECA", new Vector2(0, 1), new Vector2(28, -30), new Vector2(790, 36), 22);
        objective = PanelText("Objetivo", MissionObjective, new Vector2(0, 1), new Vector2(28, -76), new Vector2(790, 68), 30);
        clock = PanelText("Reloj", "", new Vector2(1, 1), new Vector2(-28, -52), new Vector2(330, 68), 34);
        progressFill = Meter("Progreso de libros", new Vector2(0, 1), new Vector2(28, -115), new Vector2(790, 5), new Color(.6f, .89f, .79f));
        timeFill = Meter("Tiempo restante", new Vector2(1, 1), new Vector2(-28, -91), new Vector2(330, 5), gold);
        noise = PanelText("Ruido", "EN SILENCIO", new Vector2(.5f, 1), new Vector2(0, -130), new Vector2(790, 48), 23);
        routeHint = PanelText("Siguiente referencia", RouteText(), new Vector2(.5f, 1), new Vector2(0, -190), new Vector2(1080, 48), 23);
        catalog = PanelText("Catálogo", CatalogText(), new Vector2(0, 0), new Vector2(28, 174), new Vector2(470, 164), 23);
        catalog.alignment = TextAlignmentOptions.Left;
        catalog.margin = new Vector4(16, 8, 12, 8);
        prompt = PanelText("Interacción", "", new Vector2(.5f, 0), new Vector2(0, 42), new Vector2(1300, 60), 26);
        feedback = PanelText("Avisos", "", new Vector2(.5f, 0), new Vector2(0, 300), new Vector2(1120, 70), 26);
        feedback.transform.parent.gameObject.SetActive(false);
        for (int i = 0; i < 3; i++)
        {
            var slot = U2Presentation.Image(hud.transform, "Inventario " + i, new Color(.04f, .09f, .12f, .94f));
            var r = slot.rectTransform;
            r.anchorMin = r.anchorMax = new Vector2(1, 1);
            r.pivot = new Vector2(1, .5f);
            r.anchoredPosition = new Vector2(-28, -245 - i * 110);
            r.sizeDelta = new Vector2(300, 96);
            var icon = U2Presentation.Image(slot.transform, "Libro " + bookNames[i], new Color(.45f, .5f, .55f));
            if (bookIcons != null && i < bookIcons.Length) icon.sprite = bookIcons[i];
            icon.preserveAspect = true;
            icon.rectTransform.anchoredPosition = new Vector2(-112, 0);
            icon.rectTransform.sizeDelta = new Vector2(46, 64);
            inventory.Add(icon);
            bookLabels[i] = U2Presentation.Text(slot.transform, "Estado", "PENDIENTE\n" + bookNames[i], new Vector2(28, 0), new Vector2(210, 80), 22, Color.white);
        }
        var hintButton = U2Presentation.Button(hud.transform, "Pista · −" + hintCost + " s", Vector2.zero, RevealHint);
        var hintRect = hintButton.GetComponent<RectTransform>();
        hintRect.anchorMin = hintRect.anchorMax = new Vector2(0, 0);
        hintRect.pivot = new Vector2(0, .5f); hintRect.anchoredPosition = new Vector2(28, 300);
        ResizeTouch(hintButton, new Vector2(470, 58));
        var pause = U2Presentation.Button(hud.transform, "Pausa · Esc", Vector2.zero, TogglePause);
        var pauseRect = pause.GetComponent<RectTransform>();
        pauseRect.anchorMin = pauseRect.anchorMax = new Vector2(1, 1);
        pauseRect.anchoredPosition = new Vector2(-150, -135);
        pauseRect.sizeDelta = new Vector2(244, 62);
        var pauseText = pause.GetComponentInChildren<TMP_Text>();
        U2Presentation.Stretch(pauseText.rectTransform); pauseText.fontSize = 25;
        if (Application.isMobilePlatform || SystemInfo.deviceType == DeviceType.Handheld)
        {
            // Eleva catálogo e inventario para dejar libres los controles táctiles.
            catalog.transform.parent.GetComponent<RectTransform>().anchoredPosition += new Vector2(0, 150);
            hintRect.anchoredPosition += new Vector2(0, 150);
            feedback.transform.parent.GetComponent<RectTransform>().anchoredPosition += new Vector2(0, 140);
            TouchControls();
        }
    }
    Image Meter(string name, Vector2 anchor, Vector2 position, Vector2 size, Color color)
    {
        var track = U2Presentation.Image(hud.transform, name, new Color(.12f, .2f, .25f));
        var r = track.rectTransform;
        r.anchorMin = r.anchorMax = anchor; r.pivot = new Vector2(anchor.x, .5f);
        r.anchoredPosition = position; r.sizeDelta = size;
        var fill = U2Presentation.Image(track.transform, "Relleno", color);
        U2Presentation.Stretch(fill.rectTransform);
        // Filled requiere sprite; reutiliza el sprite blanco incorporado de la UI.
        fill.sprite = Resources.GetBuiltinResource<Sprite>("UI/Skin/UISprite.psd");
        fill.type = Image.Type.Filled; fill.fillMethod = Image.FillMethod.Horizontal;
        fill.fillOrigin = 0; fill.fillAmount = name == "Progreso de libros" ? 0 : 1;
        track.raycastTarget = fill.raycastTarget = false;
        return fill;
    }
    TMP_Text PanelText(string name, string value, Vector2 anchor, Vector2 position, Vector2 size, float fontSize)
    {
        var background = U2Presentation.Image(hud.transform, name + " fondo", new Color(.04f, .09f, .12f, .87f));
        background.raycastTarget = false;
        var rect = background.rectTransform; rect.anchorMin = rect.anchorMax = anchor;
        rect.pivot = new Vector2(anchor.x, .5f); rect.anchoredPosition = position; rect.sizeDelta = size;
        var text = U2Presentation.Text(background.transform, name, value, Vector2.zero, size - new Vector2(20, 8), fontSize, Color.white);
        text.enableAutoSizing = true; text.fontSizeMin = Mathf.Max(18, fontSize - 5); text.fontSizeMax = fontSize;
        return text;
    }
    void TouchControls()
    {
        Vector2[] directions = { Vector2.left, Vector2.right, Vector2.up, Vector2.down };
        Vector2[] places = { new Vector2(-820,-340), new Vector2(-580,-340), new Vector2(-700,-230), new Vector2(-700,-450) };
        string[] labels = { "←", "→", "↑", "↓" };
        for (int i = 0; i < 4; i++)
        {
            var button = U2Presentation.Button(hud.transform, labels[i], places[i], () => {});
            ResizeTouch(button, new Vector2(100, 90));
            button.gameObject.AddComponent<TouchGameControls>().direction = directions[i];
        }
        var review = U2Presentation.Button(hud.transform, "Revisar / salir", new Vector2(680, -300), Interact);
        ResizeTouch(review, new Vector2(330, 90));
        var sprint = U2Presentation.Button(hud.transform, "Correr", new Vector2(680,-410), () => {});
        ResizeTouch(sprint, new Vector2(330, 90));
        sprint.gameObject.AddComponent<TouchGameControls>().sprint = true;
    }
    static void ResizeTouch(Button button, Vector2 size)
    {
        button.GetComponent<RectTransform>().sizeDelta = size;
        var label = button.GetComponentInChildren<TMP_Text>();
        U2Presentation.Stretch(label.rectTransform);
        label.margin = new Vector4(10, 6, 10, 6);
        label.enableAutoSizing = true; label.fontSizeMin = 20; label.fontSizeMax = 30;
    }
    void BuildRing()
    {
        var go = new GameObject("Radio de ruido al correr");
        go.transform.SetParent(transform);
        ring = go.AddComponent<LineRenderer>(); ring.useWorldSpace = false; ring.loop = true;
        ring.sharedMaterial = new Material(Shader.Find("Sprites/Default"));
        ring.startColor = ring.endColor = new Color(1f,.6f,.3f,.45f);
        ring.widthMultiplier = .035f; ring.sortingOrder = 50; ring.positionCount = 64;
        for (int i = 0; i < 64; i++) { float a = i * Mathf.PI * 2 / 64; ring.SetPosition(i, new Vector3(Mathf.Cos(a), Mathf.Sin(a), 0) * librarian.hearingRadius); }
        ring.enabled = false;
    }
    void BuildAudio()
    {
        effects = gameObject.AddComponent<AudioSource>(); effects.playOnAwake = false;
        music = gameObject.AddComponent<AudioSource>(); music.loop = true; music.playOnAwake = false;
        var config = Resources.Load<U2GameConfig>("U2GameConfig");
        AudioClip levelClip = levelMusicOverride != null ? levelMusicOverride : config?.soundtrack;
        if (levelClip != null) { music.clip = levelClip; music.volume = U2Presentation.MusicVolume * .55f; music.Play(); }
        collectSound = Tone("Libro recogido", 660, .16f, false);
        errorSound = Tone("Libro equivocado", 170, .2f, false);
        shushSound = Tone("Shhh", 0, .65f, true);
        stepSound = Tone("Paso suave", 95, .065f, true);
    }
    AudioClip Tone(string name, float frequency, float seconds, bool noiseSound)
    {
        const int rate = 22050;
        var samples = new float[Mathf.CeilToInt(rate * seconds)];
        var random = new System.Random(71);
        float smooth = 0;
        for (int i = 0; i < samples.Length; i++)
        {
            float t = i / (float)rate;
            smooth = Mathf.Lerp(smooth, (float)random.NextDouble() * 2 - 1, .3f);
            samples[i] = (noiseSound ? smooth : Mathf.Sin(t * frequency * Mathf.PI * 2)) * .35f * Mathf.Sin(Mathf.PI * i / samples.Length);
        }
        var clip = AudioClip.Create(name, samples.Length, 1, rate, false); clip.SetData(samples, 0); return clip;
    }
    void OnDestroy()
    {
        Time.timeScale = 1;
        if (player != null) player.EnvironmentSpeedMultiplier = 1f;
        TouchGameControls.Direction = Vector2.zero; TouchGameControls.Sprint = false;
        foreach (var clip in new[] { collectSound, errorSound, shushSound, stepSound }) if (clip != null) Destroy(clip);
        if (ring != null && ring.sharedMaterial != null) Destroy(ring.sharedMaterial);
    }
}
